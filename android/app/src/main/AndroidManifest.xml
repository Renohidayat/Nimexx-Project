<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rennv.nimexxv2">

    <!-- Izin Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Izin untuk query packages (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Izin untuk akses network state -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Izin untuk WebView -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Izin untuk foreground service (jika ada background playback) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Izin untuk menampilkan pop-up notifikasi (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="${applicationName}"
        android:label="Nimexx"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true">

            <!-- Tema Normal -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Intent Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Konfigurasi Flutter Embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Firebase Messaging Custom Default Icon & Color -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/custom_notification_color" />
    </application>

    <!-- Queries untuk url_launcher dan WebView - PENTING untuk Android 11+ -->
    <queries>
        <!-- Query untuk membuka HTTP/HTTPS links eksternal (Play Store, APKPure, dll) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        
        <!-- Query untuk Play Store -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        
        <!-- Query untuk browser default -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        
        <!-- Query khusus untuk domain streaming video -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:host="*.googleapis.com" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:host="*.googlevideo.com" />
        </intent>
        
        <!-- Untuk mendukung tindakan teks -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        
        <!-- Untuk WebView video streaming -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-mpegURL" />
        </intent>
    </queries>

</manifest>